# ==============================================================================
# Backend Environment Configuration Template
# ==============================================================================
APP_NAME=Your Little World API
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Database Connection URL (PostgreSQL / Supabase or local SQLite)
# Local SQLite default:
DATABASE_URL=sqlite+aiosqlite:///./test.db
# PostgreSQL / Supabase Cloud Example:
# DATABASE_URL=postgresql+asyncpg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require

# Database Connection Pool Settings (PostgreSQL only)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30

# Supabase Authentication
# In production (ENVIRONMENT=production), SUPABASE_JWT_SECRET is mandatory.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_JWT_ALGORITHM=HS256

# Timezone & Scheduling (Default: Asia/Kolkata, 8 PM Daily News Edition)
DEFAULT_TIMEZONE=Asia/Kolkata

# LLM Provider Configuration
# ------------------------------------------------------------------------------
# Development & Testing (deterministic, offline, requires no keys):
# LLM_PROVIDER=mock
#
# Production Gemini:
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-1.5-flash
#
# Production OpenAI:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_MODEL=gpt-4o-mini
#
# Optional Request Timeout (seconds):
# LLM_TIMEOUT=30.0
# ------------------------------------------------------------------------------
LLM_PROVIDER=mock
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT=30.0

# Notification Provider Configuration
# Options: "log" (default, local logger), "webhook" (HTTP POST dispatch)
NOTIFICATION_PROVIDER=log
NOTIFICATION_WEBHOOK_URL=https://your-webhook-endpoint.example.com/notifications

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
