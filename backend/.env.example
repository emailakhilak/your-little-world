# Backend Environment Configuration
APP_NAME=Your Little World API
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Supabase PostgreSQL Connection URL (Override with Supabase Cloud connection string)
# Example: postgresql+asyncpg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite+aiosqlite:///./test.db

# Supabase Auth
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
