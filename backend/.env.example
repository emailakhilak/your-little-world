# ==============================================================================
# Backend Environment Configuration Template (Your Little World)
# ==============================================================================
# Copy this file to backend/.env.
# NEVER commit real credentials, API keys, or production secrets to Git.
#
# Categories:
#   [REQUIRED IN PRODUCTION]     - Mandatory for live production deployments
#   [OPTIONAL IN PRODUCTION]     - Optional feature flags or tuning parameters
#   [DEVELOPMENT / TESTING ONLY] - Local development defaults or testing values
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
# [REQUIRED IN PRODUCTION]: Set to "production" (enforces strict auth, CORS, error handling)
# [DEVELOPMENT / TESTING ONLY]: "development" (default) or "testing"
ENVIRONMENT=development

# [DEVELOPMENT / TESTING ONLY]: Must be "false" in production. When true, exposes /docs.
DEBUG=true

# [OPTIONAL IN PRODUCTION]: Public app name
APP_NAME=Your Little World API

# [OPTIONAL IN PRODUCTION]: API route prefix
API_V1_PREFIX=/api/v1

# [OPTIONAL IN PRODUCTION]: Default timezone for news editions & scheduler catch-up
DEFAULT_TIMEZONE=Asia/Kolkata

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL via Supabase or local SQLite)
# ------------------------------------------------------------------------------
# [REQUIRED IN PRODUCTION]: Supabase PostgreSQL connection string.
# Recommended: Supabase Transaction Pooler (port 6543) with sslmode=require.
# Format: postgresql+asyncpg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
# [DEVELOPMENT / TESTING ONLY]: sqlite+aiosqlite:///./test.db
DATABASE_URL=sqlite+aiosqlite:///./test.db

# [OPTIONAL IN PRODUCTION]: Database connection pool settings (PostgreSQL only)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30

# ------------------------------------------------------------------------------
# 3. SUPABASE AUTH & JWT VERIFICATION
# ------------------------------------------------------------------------------
# [REQUIRED IN PRODUCTION]: Supabase project URL & anon key (from Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# [REQUIRED IN PRODUCTION for HS256]: Supabase JWT Secret (from API -> JWT Settings)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# [OPTIONAL IN PRODUCTION]: JWT signing algorithm. Default is HS256.
# Set to RS256/ES256 if your Supabase project uses asymmetric keys.
SUPABASE_JWT_ALGORITHM=HS256

# [OPTIONAL IN PRODUCTION]: Custom JWKS URL for asymmetric keys.
# Defaults to ${SUPABASE_URL}/auth/v1/.well-known/jwks.json if using RS256/ES256.
SUPABASE_JWKS_URL=

# ------------------------------------------------------------------------------
# 4. CORS CONFIGURATION
# ------------------------------------------------------------------------------
# [REQUIRED IN PRODUCTION]: Comma-separated list or JSON array of allowed frontend URLs.
# Wildcards ("*") are strictly prohibited in production when credentials are enabled.
# Example: CORS_ORIGINS=https://yourlittleworld.com,https://app.yourlittleworld.com
# [DEVELOPMENT / TESTING ONLY]: Default allows localhost:3000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ------------------------------------------------------------------------------
# 5. SCHEDULER CONFIGURATION
# ------------------------------------------------------------------------------
# [OPTIONAL IN PRODUCTION]: Controls in-process Faraway Window & reminder scheduler.
# Set to False on auxiliary web workers if running multiple uvicorn processes to
# prevent redundant timer queries. Default is True.
ENABLE_SCHEDULER=true

# ------------------------------------------------------------------------------
# 6. LLM PROVIDER CONFIGURATION
# ------------------------------------------------------------------------------
# [OPTIONAL IN PRODUCTION]: Options: "gemini", "openai", "mock", "none"
# Default is "mock" (offline deterministic provider for development and testing).
LLM_PROVIDER=mock

# Required only if LLM_PROVIDER=gemini:
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# Required only if LLM_PROVIDER=openai:
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# Optional timeout for AI requests (seconds):
LLM_TIMEOUT=30.0

# ------------------------------------------------------------------------------
# 7. NOTIFICATION PROVIDER CONFIGURATION
# ------------------------------------------------------------------------------
# [OPTIONAL IN PRODUCTION]: Options: "log" (stdout logger), "webhook" (HTTP POST dispatch)
NOTIFICATION_PROVIDER=log
# Required only if NOTIFICATION_PROVIDER=webhook:
NOTIFICATION_WEBHOOK_URL=https://your-webhook-endpoint.example.com/notifications
