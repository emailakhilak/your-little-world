# Backend Environment Configuration
APP_NAME=Your Little World API
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Database Connection URL (PostgreSQL / Supabase or local SQLite)
# PostgreSQL Example: postgresql+asyncpg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite+aiosqlite:///./test.db

# Supabase Authentication
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Timezone & Scheduling (Default: Asia/Kolkata, 8 PM Daily News Edition)
DEFAULT_TIMEZONE=Asia/Kolkata
NEWS_DAILY_UPDATE_HOUR=20

# LLM Provider Configuration
# Options: "mock" (default, deterministic offline provider), "gemini", "openai", "anthropic"
LLM_PROVIDER=mock
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
