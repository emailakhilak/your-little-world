# ==============================================================================
# Your Little World - Environment Configuration Template
# ==============================================================================
# Copy this file to:
#   - backend/.env
#   - frontend/.env.local
# Replace the placeholders below with your actual values from Supabase Cloud.
# NEVER commit .env or .env.local files containing real secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# SUPABASE CONFIGURATION (Cloud Project)
# ------------------------------------------------------------------------------
# Found in: Supabase Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-here

# Frontend-exposed variables (Must be prefixed with NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ------------------------------------------------------------------------------
# DATABASE CONNECTION (PostgreSQL via Supabase)
# ------------------------------------------------------------------------------
# Connection string from Supabase Settings -> Database (Use Connection Pooling / Session mode)
# Format for asyncpg: postgresql+asyncpg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/your_little_world

# ------------------------------------------------------------------------------
# BACKEND SETTINGS
# ------------------------------------------------------------------------------
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]
APP_NAME=Your Little World API
API_V1_PREFIX=/api/v1
DEBUG=true
