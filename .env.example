# ==============================================================================
# Your Little World - Environment Configuration Template
# ==============================================================================
# Copy this file to:
#   - backend/.env
#   - frontend/.env.local
# Replace the placeholders below with your actual values from Supabase Cloud.
# NEVER commit .env or .env.local files containing real secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# SUPABASE CONFIGURATION (Cloud Project)
# ------------------------------------------------------------------------------
# Found in: Supabase Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-here
SUPABASE_JWT_ALGORITHM=HS256

# Frontend-exposed variables (Must be prefixed with NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ------------------------------------------------------------------------------
# DATABASE CONNECTION (PostgreSQL via Supabase or Local SQLite)
# ------------------------------------------------------------------------------
# Default for offline development & tests:
# DATABASE_URL=sqlite+aiosqlite:///./test.db
#
# Production Supabase PostgreSQL:
# Connection string from Supabase Project Settings -> Database -> Connection string
# Use Connection Pooling / Transaction Mode (port 6543) or Session Mode (port 5432).
# When using transaction pooling (port 6543), statement_cache_size=0 is automatically handled.
# Format: postgresql+asyncpg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/your_little_world

# Database Connection Pool Settings (PostgreSQL only)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30

# ------------------------------------------------------------------------------
# BACKEND & AUTOMATION SETTINGS
# ------------------------------------------------------------------------------
ENVIRONMENT=development
APP_NAME=Your Little World API
API_V1_PREFIX=/api/v1
DEBUG=true
DEFAULT_TIMEZONE=Asia/Kolkata
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ------------------------------------------------------------------------------
# LLM & AI SETTINGS
# ------------------------------------------------------------------------------
# Options:
#   - Development & Tests: LLM_PROVIDER=mock (requires no external API keys)
#   - Production Gemini:   LLM_PROVIDER=gemini (requires GEMINI_API_KEY)
#   - Production OpenAI:   LLM_PROVIDER=openai (requires OPENAI_API_KEY)
#   - Disabled:            LLM_PROVIDER=none
LLM_PROVIDER=mock
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT=30.0

# ------------------------------------------------------------------------------
# NOTIFICATION SETTINGS
# ------------------------------------------------------------------------------
# Options: "log" (default offline logging provider), "webhook"
NOTIFICATION_PROVIDER=log
NOTIFICATION_WEBHOOK_URL=https://your-webhook-endpoint.example.com/notifications
