# ==============================================================================
# Frontend Environment Configuration Template (Your Little World)
# ==============================================================================
# Copy this file to frontend/.env.local.
#
# IMPORTANT:
# - All variables exposed to the browser MUST start with NEXT_PUBLIC_.
# - NEVER put backend secrets (SUPABASE_JWT_SECRET, GEMINI_API_KEY, DATABASE_URL)
#   into frontend/.env.local or any NEXT_PUBLIC_* variable.
#
# Categories:
#   [REQUIRED IN PRODUCTION]     - Mandatory for live production deployments
#   [DEVELOPMENT / TESTING ONLY] - Local offline sanctuary defaults
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND API ENDPOINT
# ------------------------------------------------------------------------------
# [REQUIRED IN PRODUCTION]: Public backend HTTPS URL (e.g. https://api.yourlittleworld.com/api/v1).
# Trailing slashes and omitted '/api/v1' are automatically normalized by the client.
# [DEVELOPMENT / TESTING ONLY]: Default points to local FastAPI server
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ------------------------------------------------------------------------------
# 2. SUPABASE CLIENT AUTHENTICATION
# ------------------------------------------------------------------------------
# [REQUIRED IN PRODUCTION]: Supabase project URL & anon public key.
# When configured, real Supabase user sessions (JWTs) are sent with API requests.
# [DEVELOPMENT / TESTING ONLY]: When left empty, the frontend runs in
# Standalone Local Sanctuary (offline development) mode with local test tokens.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
